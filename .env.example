# Copy to .env.local (local) — and add the same in Vercel for production.

GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
GOOGLE_SHEETS_WEBHOOK_SECRET="a-long-random-secret-also-pasted-into-apps-script"
# Production: your real domain, e.g. https://lawvoo.com (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Search Console → Add property → "HTML tag" → paste only the content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Enquiry form: on unless set to "false". Pay the ICO data protection fee while it is on.
LEADS_ENABLED="true"

# Shown on the Privacy and Terms pages. Add a postal address (a virtual
# office is fine) before launch; add the ICO number once the fee is paid.
NEXT_PUBLIC_BUSINESS_NAME="Lawvoo"
NEXT_PUBLIC_CONTACT_EMAIL="lawvoo12@gmail.com"
NEXT_PUBLIC_BUSINESS_ADDRESS=""
NEXT_PUBLIC_ICO_NUMBER=""

# Listing update/removal requests from solicitors go here.
NEXT_PUBLIC_LISTINGS_EMAIL="lawvoo12@gmail.com"

# Cloudflare Turnstile (spam protection) — dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional: email alert for every lead (resend.com)
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL=""
